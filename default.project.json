{
  "name": "roblox-ts-model",
  "globIgnorePaths": ["**/package.json", "**/tsconfig.json"],
  "tree": {
    "$className": "DataModel",
    "ReplicatedStorage": {
      "hitboxed": {
        "$className": "Folder",
        "lib": {
          "$path": "out/lib"
        },
        "include": {
          "$path": "include",
          "node_modules": {
            "$className": "Folder",
            "@rbxts": {
              "$path": "node_modules/@rbxts"
            }
          }
        }
      }
    },
    "ServerScriptService": {
      "hitboxed": {
        "$className": "Folder",
        "lib": {
          "$path": "out/server"
        }
      }
    }
  }
}
